"Post.PublishedAt" [shape=ellipse, color="#7A6A5A", fontname="Helvetica", fontsize=10, height=0.3, label="PublishedAt"];
"Post" -- "Post.PublishedAt" [len=1.1];
"Post.UpdatedAt" [shape=ellipse, color="#7A6A5A", fontname="Helvetica", fontsize=10, height=0.3, label="UpdatedAt"];
"Post" -- "Post.UpdatedAt" [len=1.1];
