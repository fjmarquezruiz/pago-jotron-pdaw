"r_ref_win" [shape=diamond, style="filled", fillcolor="#FFFFFF", color="#5B2333", fontname="Helvetica", fontsize=11, label="referencia"];
"Post" -- "r_ref_win" [label="N", fontsize=11, fontcolor="#5B2333", len=1.6];
