graph "bbdd-er-clasico-contenido" {
graph [overlap=false, splines=true, sep="+12", pad=0.4, nodesep=0.35, ranksep=0.6, label="Blog y log · ampliado", labelloc=t, fontsize=18, fontname="Helvetica-Bold", bgcolor="white"];
edge [color="#7A6A5A"];
"AuditLog" [shape=box, style="filled", fillcolor="#F3E9DC", color="#5B2333", fontname="Helvetica-Bold", fontsize=13, penwidth=1.6];
"AuditLog.AuditLogID" [shape=ellipse, color="#7A6A5A", fontname="Helvetica", fontsize=10, height=0.3, label=<<u>AuditLogID</u>>];
"AuditLog" -- "AuditLog.AuditLogID" [len=1.1];
"AuditLog.Action" [shape=ellipse, color="#7A6A5A", fontname="Helvetica", fontsize=10, height=0.3, label="Action"];
"AuditLog" -- "AuditLog.Action" [len=1.1];
"AuditLog.LoggedAt" [shape=ellipse, color="#7A6A5A", fontname="Helvetica", fontsize=10, height=0.3, label="LoggedAt"];
