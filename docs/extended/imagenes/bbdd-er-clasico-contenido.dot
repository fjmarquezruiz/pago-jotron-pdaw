"GuaranteeOfOrigin" [shape=box, style="dashed", color="#5B2333", fontname="Helvetica", fontsize=12];
"Post" [shape=box, style="filled", fillcolor="#F3E9DC", color="#5B2333", fontname="Helvetica-Bold", fontsize=13, penwidth=1.6];
"Post.PostID" [shape=ellipse, color="#7A6A5A", fontname="Helvetica", fontsize=10, height=0.3, label=<<u>PostID</u>>];
