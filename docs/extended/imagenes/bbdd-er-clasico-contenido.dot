"leyenda" [shape=plaintext, fontname="Helvetica", fontsize=11, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#F3E9DC">Modelo de docs/tarea02</td></tr><tr><td bgcolor="#E4EFE0"><font color="#2F5D3A">Ampliación (nuevo)</font></td></tr></table>>];
