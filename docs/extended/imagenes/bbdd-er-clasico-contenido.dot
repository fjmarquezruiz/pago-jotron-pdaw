"User" [shape=box, style="dashed", color="#5B2333", fontname="Helvetica", fontsize=12];
"Winery" [shape=box, style="dashed", color="#5B2333", fontname="Helvetica", fontsize=12];
"r_publica" [shape=diamond, style="filled", fillcolor="#FFFFFF", color="#5B2333", fontname="Helvetica", fontsize=11, label="publica"];
