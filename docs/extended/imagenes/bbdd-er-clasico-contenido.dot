"r_publica" -- "Post" [label="N", fontsize=11, fontcolor="#5B2333", len=1.6];
"r_genera_log" [shape=diamond, style="filled", fillcolor="#FFFFFF", color="#5B2333", fontname="Helvetica", fontsize=11, label="genera"];
